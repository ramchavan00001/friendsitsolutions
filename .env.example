# ─── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.friendsitsolutions.com

# ─── Email (Resend) — admin notifications + client auto-replies ───
RESEND_API_KEY=
EMAIL_FROM="FriendsITSolutions <no-reply@friendsitsolutions.com>"
# Comma-separated list of addresses that receive new submissions
ADMIN_EMAIL=hello@friendsitsolutions.com

# ─── Database & file storage (Supabase) ───
SUPABASE_URL=
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOAD_BUCKET=uploads
# Salt used to hash IP addresses before storing them
IP_HASH_SALT=change-me

# ─── Spam protection (Cloudflare Turnstile) — leave empty to disable ───
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Admin dashboard (/admin) — HTTP Basic Auth. Dashboard is locked if unset. ───
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ─── Headless CMS (Sanity) — leave empty to use local content in src/content ───
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Only needed for private datasets
SANITY_API_TOKEN=

# ─── AI chatbot (Claude) — leave empty to use the built-in FAQ matcher ───
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
ANTHROPIC_MODEL=

# ─── Booking (Cal.com) ───
NEXT_PUBLIC_CAL_LINK=friendsitsolutions/30min

# ─── Analytics (loaded only after cookie consent) ───
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
